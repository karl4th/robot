[Unit]
Description=Local robot control center
After=network.target

[Service]
Type=simple
User=robot
Group=robot
SupplementaryGroups=dialout
WorkingDirectory=/home/robot/Documents/robot
ExecStart=/home/robot/Documents/robot/.venv/bin/python -m robot.dashboard --host 0.0.0.0 --http-port 8765 --max-rpm 50 --auto-ports
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
