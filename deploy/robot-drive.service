[Unit]
Description=Local robot drive controls
After=network.target

[Service]
Type=simple
User=robot
Group=robot
SupplementaryGroups=dialout
WorkingDirectory=/home/robot/Documents/robot
ExecStart=/home/robot/Documents/robot/.venv/bin/python -m robot.drive --host 0.0.0.0 --http-port 8766 --max-rpm 50
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
